# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Never prefix with NEXT_PUBLIC_. Used for sending invites, deactivating logins, calendar sync.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
NEXT_PUBLIC_CHAPTER_NAME=Pi Beta Phi Maryland Gamma
NEXT_PUBLIC_CHAPTER_TIMEZONE=America/New_York

# --- Google Calendar ---
GOOGLE_CALENDAR_ID=fb9fb41dcb988c312d97fde66e23dc1669ff686a33f597a0700a7e315b0a2071@group.calendar.google.com
# Public calendar: an API key (Google Cloud → APIs & Services → Credentials, restrict it to the Calendar API).
GOOGLE_API_KEY=
# Private calendar: instead, a service account JSON (share the calendar with its client_email, "See all event details").
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Email (resend.com) ---
RESEND_API_KEY=
EMAIL_FROM=Chapter Hub <hub@your-domain.com>

# --- Cron (random string, at least 16 chars; Vercel sends it automatically) ---
CRON_SECRET=
